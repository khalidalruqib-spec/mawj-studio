{
  "language": "mixed",
  "animations": [
    "fadeIn",
    "fadeOut",
    "slideUp",
    "slideDown",
    "slideLeft",
    "slideRight",
    "zoomIn",
    "zoomOut",
    "pop",
    "bounce",
    "typewriter",
    "blurReveal",
    "rotateIn"
  ],
  "transitions": [
    "cut",
    "fade",
    "slide",
    "zoom",
    "wipe",
    "blur"
  ],
  "id": "restaurant-offer",
  "name": "Restaurant Offer 9:16",
  "category": "Restaurants",
  "aspectRatio": "9:16",
  "width": 1080,
  "height": 1920,
  "duration": 18,
  "description": "A food offer template with food closeup, price, location, order number, and logo.",
  "safeMargins": {
    "top": 160,
    "bottom": 260,
    "left": 70,
    "right": 70
  },
  "requiredInputs": [
    {
      "key": "restaurantName",
      "label": "Restaurant Name",
      "type": "text",
      "default": "Restaurant Name"
    },
    {
      "key": "offerTitle",
      "label": "Offer Title",
      "type": "text",
      "default": "Lunch Offer"
    },
    {
      "key": "foodImage",
      "label": "Food Image",
      "type": "image"
    },
    {
      "key": "price",
      "label": "Price",
      "type": "text",
      "default": "SAR 39"
    },
    {
      "key": "location",
      "label": "Location",
      "type": "text",
      "default": "Khobar"
    },
    {
      "key": "orderNumber",
      "label": "Order Number",
      "type": "text",
      "default": "920000000"
    },
    {
      "key": "logo",
      "label": "Logo",
      "type": "image"
    },
    {
      "key": "brandColor",
      "label": "Brand Color",
      "type": "color",
      "default": "#ea580c"
    }
