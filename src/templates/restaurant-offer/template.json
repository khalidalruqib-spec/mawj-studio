          "x": 100,
          "y": 700,
          "width": 880,
          "height": 90,
          "fontSize": 48,
          "fontWeight": "bold",
          "color": "#ffedd5",
          "align": "center",
          "direction": "ltr",
          "safeMargin": true,
          "animationIn": {
            "type": "fadeIn",
            "duration": 0.35
