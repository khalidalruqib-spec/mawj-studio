          "x": 0,
          "y": 0,
          "width": 1080,
          "height": 1920,
          "fit": "cover",
          "safeMargin": false,
          "animationIn": {
            "type": "zoomIn",
            "duration": 0.55
          }
        },
        {
          "id": "food-shade",
          "type": "shape",
