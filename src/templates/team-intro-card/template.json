          "x": 220,
          "y": 950,
          "width": 640,
          "height": 46,
          "fontSize": 36,
          "fontWeight": "bold",
          "color": "{{accentColor}}",
          "align": "center",
          "direction": "rtl",
          "editable": true,
          "animationIn": {
            "type": "fadeIn",
            "duration": 0.4,
            "delay": 0.5
          }
        },
        {
          "id": "mb-bio",
          "type": "text",
          "content": "{{bio}}",
          "x": 70,
          "y": 1060,
          "width": 940,
          "height": 220,
          "fontSize": 46,
          "fontWeight": "normal",
          "color": "#ccddee",
          "align": "center",
          "direction": "rtl",
          "safeMargin": true,
          "editable": true,
          "animationIn": {
            "type": "slideUp",
            "duration": 0.5,
            "delay": 0.7
          }
        }
      ]
    },
    {
