          "y": 520,
          "width": 890,
          "height": 280,
          "color": "#ffffff",
          "opacity": 1,
          "borderRadius": 36,
          "safeMargin": true
        },
        {
          "id": "items",
          "type": "text",
          "content": "{{items}}",
          "x": 125,
          "y": 575,
          "width": 830,
          "height": 170,
          "fontSize": 42,
          "fontWeight": "bold",
          "color": "#7f1d1d",
          "align": "center",
          "direction": "auto",
          "safeMargin": true,
          "animationIn": {
            "type": "slideUp",
            "duration": 0.4
          }
        }
      ]
    },
    {
      "id": "price",
      "name": "Price Flash",
      "start": 8,
      "duration": 4,
      "background": {
        "type": "color",
        "value": "#111111"
      },
      "transition": {
        "type": "zoom",
        "duration": 0.25
      },
      "layers": [
        {
          "id": "price",
          "type": "text",
          "content": "{{price}}",
          "x": 70,
          "y": 450,
          "width": 940,
          "height": 190,
          "fontSize": 126,
          "fontWeight": "bold",
          "color": "{{brandColor}}",
          "align": "center",
          "direction": "auto",
          "safeMargin": true,
          "animationIn": {
            "type": "pop",
            "duration": 0.45
          }
        },
        {
          "id": "value",
          "type": "text",
          "content": "عرض اليوم فقط",
          "x": 100,
          "y": 700,
          "width": 880,
          "height": 90,
          "fontSize": 50,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "direction": "auto",
          "safeMargin": true,
          "animationIn": {
            "type": "slideUp",
            "duration": 0.4
          }
        }
      ]
    },
    {
      "id": "order",
      "name": "Order CTA",
      "start": 12,
      "duration": 4,
      "background": {
        "type": "gradient",
        "from": "{{brandColor}}",
        "to": "#450a0a"
      },
      "transition": {
        "type": "wipe",
        "duration": 0.25
      },
      "layers": [
        {
          "id": "location",
          "type": "text",
          "content": "{{location}}",
          "x": 80,
          "y": 360,
          "width": 920,
          "height": 110,
          "fontSize": 46,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "direction": "auto",
          "safeMargin": true,
          "animationIn": {
            "type": "slideUp",
            "duration": 0.4
          }
        },
        {
          "id": "order-bg",
          "type": "shape",
          "shape": "rect",
          "x": 120,
          "y": 690,
          "width": 840,
          "height": 140,
          "color": "#ffffff",
          "opacity": 1,
          "borderRadius": 70,
          "safeMargin": true
        },
        {
          "id": "order",
          "type": "text",
          "content": "{{orderNumber}}",
          "x": 120,
          "y": 728,
          "width": 840,
          "height": 74,
          "fontSize": 52,
          "fontWeight": "bold",
          "color": "{{brandColor}}",
          "align": "center",
          "direction": "ltr",
          "safeMargin": true,
          "animationIn": {
            "type": "slideUp",
            "duration": 0.4
          }
        }
