      },
      "transition": {
        "type": "slide",
        "duration": 0.25
      },
      "layers": [
        {
          "id": "offer-title",
          "type": "text",
          "content": "{{offerTitle}}",
          "x": 80,
          "y": 260,
          "width": 920,
          "height": 150,
          "fontSize": 70,
          "fontWeight": "bold",
          "color": "#111827",
          "align": "center",
          "direction": "auto",
          "safeMargin": true,
          "animationIn": {
            "type": "slideUp",
            "duration": 0.4
          }
        },
        {
