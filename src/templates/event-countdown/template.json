{
  "language": "mixed",
  "animations": [
    "fadeIn",
    "fadeOut",
    "slideUp",
    "slideDown",
    "slideLeft",
    "slideRight",
    "zoomIn",
    "zoomOut",
    "pop",
    "bounce",
    "typewriter",
    "blurReveal",
    "rotateIn"
  ],
  "transitions": [
    "cut",
    "fade",
    "slide",
    "zoom",
    "wipe",
    "blur"
  ],
  "id": "event-countdown",
  "name": "Event Countdown Announcement",
  "category": "Event Announcements",
  "aspectRatio": "9:16",
  "width": 1080,
  "height": 1920,
  "duration": 15,
  "description": "High-impact 3-scene event announcement: dramatic teaser → event details → registration CTA. Drives registrations for conferences, workshops, meetups, and live events.",
  "safeMargins": {
    "top": 160,
    "bottom": 260,
    "left": 70,
    "right": 70
  },
  "requiredInputs": [
    {
      "key": "eventName",
      "label": "Event Name",
      "type": "text",
      "default": "قمة ريادة الأعمال ٢٠٢٦",
      "placeholder": "اسم الحدث",
      "required": true
    },
    {
      "key": "date",
      "label": "Event Date",
      "type": "text",
      "default": "السبت ١٥ يونيو ٢٠٢٦",
      "placeholder": "تاريخ الحدث",
      "required": true
    },
    {
      "key": "venue",
      "label": "Venue / Location",
      "type": "text",
      "default": "فندق الريتز كارلتون، الرياض",
      "placeholder": "المكان",
      "required": true
    },
    {
      "key": "ticketPrice",
      "label": "Ticket Price",
      "type": "text",
      "default": "٥٠٠ ريال",
      "placeholder": "سعر التذكرة",
      "required": true
    },
    {
      "key": "link",
      "label": "Registration Link",
      "type": "text",
      "default": "www.event-register.com",
      "placeholder": "رابط التسجيل",
      "required": true
    },
    {
      "key": "logo",
      "label": "Event / Brand Logo",
      "type": "image",
      "required": false
    },
    {
      "key": "brandColor",
      "label": "Brand Color",
      "type": "color",
      "default": "#f59e0b",
      "required": false
    }
