      "default": "الحكومة تعلن عن حزمة دعم اقتصادية تاريخية",
      "placeholder": "العنوان الرئيسي للخبر",
      "required": true
    },
    {
      "key": "subHeadline",
      "label": "Sub Headline",
      "type": "text",
      "default": "تفاصيل جديدة تكشف عن ٣٠٠ مليار ريال دعم مباشر",
      "placeholder": "العنوان الفرعي",
      "required": true
    },
    {
      "key": "body",
      "label": "Body Text",
