          "x": 0,
          "y": 0,
          "width": 1920,
          "height": 1080,
          "color": "{{brandColor}}",
          "opacity": 0.18,
          "borderRadius": 0,
          "safeMargin": false
        },
        {
          "id": "breaking-text",
          "type": "text",
          "content": "BREAKING",
          "x": 180,
          "y": 330,
          "width": 1560,
          "height": 150,
          "fontSize": 118,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "direction": "ltr",
          "safeMargin": true,
          "animationIn": {
            "type": "slideLeft",
            "duration": 0.45
          },
          "fontFamily": "var(--font-arabic), Cairo, \"IBM Plex Sans Arabic\", \"Noto Sans Arabic\", Tahoma, Arial, sans-serif",
          "lineHeight": 1.12,
          "letterSpacing": 0,
          "textStrokeColor": "rgba(0,0,0,0.76)",
          "textStrokeWidth": 7,
          "shadowColor": "rgba(0,0,0,0.38)",
          "shadowBlur": 14,
          "shadowOffsetX": 0,
          "shadowOffsetY": 7,
          "backgroundPadding": 0,
          "textTransform": "none"
        },
        {
