{
  "language": "mixed",
  "animations": [
    "fadeIn",
    "fadeOut",
    "slideUp",
    "slideDown",
    "slideLeft",
    "slideRight",
    "zoomIn",
    "pop",
    "bounce",
    "blurReveal",
    "rotateIn"
  ],
  "transitions": [
    "cut",
    "fade",
    "slide",
    "zoom",
    "wipe",
    "blur"
  ],
  "width": 1920,
  "height": 1080,
  "safeMargins": {
    "top": 80,
    "bottom": 90,
    "left": 110,
    "right": 110
  },
  "audio": {
    "music": null,
    "volume": 0.35
  },
  "export": {
    "format": "mp4",
    "fps": 30,
    "quality": "1080p"
  },
  "id": "market-news-bulletin-wide",
  "name": "Market News Bulletin 16:9",
  "category": "News Style",
  "aspectRatio": "16:9",
  "duration": 16,
  "description": "Original modern news bulletin with breaking opener, headline, details, source strap, and closing bug.",
  "requiredInputs": [
    {
      "key": "newsTitle",
      "label": "العنوان",
      "type": "text",
      "default": "خبر عاجل في السوق المحلي"
    },
    {
      "key": "newsSummary",
      "label": "الملخص",
      "type": "textarea",
      "default": "تفاصيل موجزة وواضحة تظهر على الشاشة بطريقة إخبارية احترافية."
    },
    {
      "key": "sourceName",
      "label": "المصدر",
      "type": "text",
      "default": "Mawj Newsroom"
    },
    {
      "key": "imageOrVideo",
      "label": "الصورة أو الفيديو",
      "type": "image"
    },
    {
      "key": "logo",
      "label": "الشعار",
      "type": "image"
    },
    {
      "key": "brandColor",
      "label": "لون الهوية",
      "type": "color",
      "default": "#dc2626"
    }
  ],
  "scenes": [
    {
      "id": "breaking",
      "name": "Breaking Opener",
      "start": 0,
      "duration": 3,
      "background": {
        "type": "color",
        "value": "#111111"
      },
      "transition": {
        "type": "cut",
        "duration": 0.1
      },
      "layers": [
        {
          "id": "red-bar",
