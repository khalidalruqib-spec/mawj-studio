    {
      "key": "collectionName",
      "label": "اسم المجموعة",
      "type": "text",
      "default": "مجموعة الصيف"
    },
    {
      "key": "tagline",
      "label": "الوصف القصير",
      "type": "text",
      "default": "قصّات خفيفة وألوان ناعمة"
