    {
      "key": "productImage",
      "label": "صورة المنتج",
      "type": "image"
    },
    {
      "key": "offer",
      "label": "العرض",
      "type": "text",
      "default": "خصم 25%"
    },
    {
      "key": "cta",
      "label": "الدعوة",
      "type": "text",
      "default": "تسوّق الآن"
