        "type": "fade",
        "duration": 0.5
      },
      "layers": [
        {
          "id": "i-img",
          "type": "image",
          "src": "{{image}}",
          "x": 0,
          "y": 0,
          "width": 1080,
          "height": 1920,
          "fit": "cover",
          "opacity": 0.4,
          "animationIn": {
            "type": "zoomIn",
            "duration": 0.8
          }
        },
        {
          "id": "i-overlay",
