          "height": 80,
          "fontSize": 58,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "direction": "ltr",
          "safeMargin": true,
          "animationIn": {
            "type": "fadeIn",
            "duration": 0.35
          }
        }
      ]
    },
    {
      "id": "result",
      "name": "Result Text",
      "start": 12,
      "duration": 2,
