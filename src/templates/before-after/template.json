    "top": 160,
    "bottom": 260,
    "left": 70,
    "right": 70
  },
  "requiredInputs": [
    {
      "key": "beforeImage",
      "label": "Before Image",
      "type": "image"
    },
    {
      "key": "afterImage",
      "label": "After Image",
      "type": "image"
    },
    {
      "key": "title",
      "label": "Title",
      "type": "text",
      "default": "Before / After"
    },
    {
      "key": "description",
      "label": "Description",
      "type": "textarea",
      "default": "See the transformation."
    },
    {
      "key": "cta",
      "label": "CTA",
      "type": "text",
      "default": "Book now"
    },
    {
      "key": "logo",
      "label": "Logo",
      "type": "image"
    },
    {
      "key": "brandColor",
      "label": "Brand Color",
      "type": "color",
      "default": "#16a34a"
    }
