          "x": 420,
          "y": 920,
          "width": 240,
          "height": 140,
          "fit": "contain",
          "safeMargin": true,
          "animationIn": {
            "type": "zoomIn",
            "duration": 0.55
          }
        }
      ]
    },
    {
      "id": "cta",
