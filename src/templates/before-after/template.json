      "layers": [
        {
          "id": "before-img",
          "type": "image",
          "src": "{{beforeImage}}",
          "x": 0,
          "y": 0,
          "width": 1080,
          "height": 1920,
          "fit": "cover",
          "safeMargin": false,
          "animationIn": {
            "type": "zoomIn",
            "duration": 0.55
          }
        },
        {
          "id": "label-bg",
          "type": "shape",
          "shape": "rect",
          "x": 100,
          "y": 240,
          "width": 880,
          "height": 120,
          "color": "#000000",
          "opacity": 0.58,
          "borderRadius": 36,
          "safeMargin": true
        },
        {
          "id": "before-label",
          "type": "text",
          "content": "Before",
          "x": 100,
          "y": 260,
          "width": 880,
          "height": 80,
          "fontSize": 58,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
