{
  "language": "mixed",
  "animations": [
    "fadeIn",
    "fadeOut",
    "slideUp",
    "slideDown",
    "slideLeft",
    "slideRight",
    "zoomIn",
    "zoomOut",
    "pop",
    "bounce",
    "typewriter",
    "blurReveal",
    "rotateIn"
  ],
  "transitions": [
    "cut",
    "fade",
    "slide",
    "zoom",
    "wipe",
    "blur"
  ],
  "id": "before-after",
  "name": "Before / After 9:16",
  "category": "Before / After",
  "aspectRatio": "9:16",
  "width": 1080,
  "height": 1920,
  "duration": 16,
  "description": "A transformation template with before image, transition reveal, after image, result text, and CTA.",
