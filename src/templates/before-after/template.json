          "width": 880,
          "height": 140,
          "fontSize": 70,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "direction": "auto",
          "safeMargin": true,
          "animationIn": {
            "type": "blurReveal",
            "duration": 0.55
