    "fadeIn",
    "fadeOut",
    "slideUp",
    "slideDown",
    "slideLeft",
    "slideRight",
    "zoomIn",
    "zoomOut",
    "pop",
    "bounce",
    "typewriter",
    "blurReveal",
    "rotateIn"
  ],
