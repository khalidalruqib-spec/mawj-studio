  "id": "personal-intro",
  "name": "Personal Brand Intro",
  "category": "Personal Branding",
  "aspectRatio": "9:16",
  "width": 1080,
  "height": 1920,
  "duration": 20,
  "description": "Clean 3-scene personal branding intro: name reveal → expertise showcase → connect CTA. Perfect for creators, coaches, and professionals introducing themselves on social media.",
  "safeMargins": {
    "top": 160,
    "bottom": 260,
    "left": 70,
    "right": 70
  },
  "requiredInputs": [
    {
      "key": "fullName",
      "label": "Full Name",
      "type": "text",
      "default": "سارة المنصوري",
      "placeholder": "اسمك الكامل",
      "required": true
    },
    {
      "key": "roleTitle",
      "label": "Role / Title",
      "type": "text",
      "default": "مدربة حياة ومتحدثة تحفيزية",
      "placeholder": "مسماك المهني أو التخصص",
      "required": true
    },
    {
      "key": "bio",
      "label": "Short Bio",
      "type": "textarea",
      "default": "أساعدك تكتشف قوتك الداخلية وتحقق أهدافك في ٩٠ يوماً",
      "placeholder": "نبذة قصيرة عنك",
      "required": true
    },
    {
      "key": "skill1",
      "label": "Skill / Tag 1",
      "type": "text",
      "default": "تطوير الذات",
      "placeholder": "مهارة أو تخصص ١",
      "required": true
    },
    {
      "key": "skill2",
      "label": "Skill / Tag 2",
      "type": "text",
      "default": "التدريب الحياتي",
      "placeholder": "مهارة أو تخصص ٢",
      "required": true
    },
    {
      "key": "skill3",
      "label": "Skill / Tag 3",
      "type": "text",
      "default": "بناء العادات",
      "placeholder": "مهارة أو تخصص ٣",
      "required": true
    },
    {
      "key": "igHandle",
      "label": "Instagram Handle",
      "type": "text",
      "default": "@sara.almansouri",
      "placeholder": "@حسابك على انستغرام",
      "required": true
    },
    {
      "key": "website",
      "label": "Website / Link",
      "type": "text",
      "default": "www.sara-coach.com",
      "placeholder": "موقعك الإلكتروني",
      "required": false
    },
    {
      "key": "photo",
      "label": "Your Photo",
      "type": "image",
      "required": true
    },
    {
      "key": "brandColor",
      "label": "Brand Color",
      "type": "color",
      "default": "#8b5cf6",
      "required": false
    }
