  "id": "motivational-quote",
  "name": "Motivational Quote",
  "category": "TikTok / Reels",
  "aspectRatio": "9:16",
  "width": 1080,
  "height": 1920,
  "duration": 15,
  "description": "Elegant 3-scene motivational quote template: atmospheric intro → typewriter quote reveal → branded outro. Perfect for daily inspiration, wisdom, and engagement content.",
  "safeMargins": {
    "top": 160,
    "bottom": 260,
    "left": 70,
    "right": 70
  },
  "requiredInputs": [
    {
      "key": "quote",
      "label": "Quote Text",
      "type": "textarea",
      "default": "النجاح ليس مصادفة، هو نتيجة عمل متواصل وإيمان لا يتزعزع بالهدف",
      "placeholder": "اكتب الاقتباس أو الحكمة",
      "required": true
    },
    {
      "key": "author",
      "label": "Quote Author",
      "type": "text",
      "default": "— ستيف جوبز",
      "placeholder": "مثال: — اسم القائل",
      "required": false
    },
    {
      "key": "handle",
      "label": "Your Handle",
      "type": "text",
      "default": "@daily.wisdom.ar",
      "placeholder": "@حسابك",
      "required": true
    },
    {
      "key": "logo",
      "label": "Logo / Icon",
      "type": "image",
      "required": false
    },
    {
      "key": "color1",
      "label": "Gradient Color 1 (From)",
      "type": "color",
      "default": "#7ef2bc",
      "required": false
    },
    {
      "key": "color2",
      "label": "Gradient Color 2 (To)",
      "type": "color",
      "default": "#a78bfa",
      "required": false
    }
  ],
