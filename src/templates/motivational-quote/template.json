{
  "language": "mixed",
  "animations": [
    "fadeIn",
    "fadeOut",
    "slideUp",
    "slideDown",
    "slideLeft",
    "slideRight",
    "zoomIn",
    "zoomOut",
    "pop",
    "bounce",
    "typewriter",
    "blurReveal",
    "rotateIn"
  ],
  "transitions": [
    "cut",
    "fade",
    "slide",
    "zoom",
    "wipe",
    "blur"
