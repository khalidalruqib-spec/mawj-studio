        "to": "#111827"
      },
      "transition": {
        "type": "cut",
        "duration": 0
      },
      "layers": [
        {
          "id": "course",
          "type": "text",
          "content": "{{courseName}}",
          "x": 100,
          "y": 350,
          "width": 880,
          "height": 150,
          "fontSize": 68,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "direction": "auto",
          "safeMargin": true,
          "animationIn": {
            "type": "fadeIn",
            "duration": 0.35
          }
        },
        {
          "id": "trainer",
          "type": "text",
          "content": "with {{trainerName}}",
          "x": 100,
          "y": 560,
          "width": 880,
          "height": 80,
          "fontSize": 42,
          "fontWeight": "bold",
          "color": "#ede9fe",
          "align": "center",
          "direction": "ltr",
          "safeMargin": true,
          "animationIn": {
            "type": "fadeIn",
            "duration": 0.35
