{
  "language": "mixed",
  "animations": [
    "fadeIn",
    "fadeOut",
    "slideUp",
    "slideDown",
    "slideLeft",
    "slideRight",
    "zoomIn",
    "zoomOut",
    "pop",
    "bounce",
    "typewriter",
    "blurReveal",
    "rotateIn"
  ],
  "transitions": [
    "cut",
    "fade",
    "slide",
    "zoom",
    "wipe",
    "blur"
  ],
  "id": "course-announcement",
  "name": "Course Announcement 9:16",
  "category": "Course Announcements",
  "aspectRatio": "9:16",
  "width": 1080,
  "height": 1920,
  "duration": 22,
  "description": "A course announcement template with title, learning points, trainer, date, price, and registration CTA.",
  "safeMargins": {
    "top": 160,
    "bottom": 260,
    "left": 70,
    "right": 70
  },
  "requiredInputs": [
    {
      "key": "courseName",
      "label": "Course Name",
      "type": "text",
      "default": "AI Content Course"
    },
    {
      "key": "trainerName",
      "label": "Trainer Name",
      "type": "text",
      "default": "Trainer Name"
    },
    {
      "key": "date",
      "label": "Date",
      "type": "text",
      "default": "June 20"
    },
    {
      "key": "price",
      "label": "Price",
      "type": "text",
      "default": "SAR 499"
    },
    {
      "key": "registrationLink",
      "label": "Registration Link",
      "type": "text",
      "default": "example.com"
    },
    {
      "key": "logo",
      "label": "Logo",
      "type": "image"
    },
    {
      "key": "brandColor",
      "label": "Brand Color",
      "type": "color",
      "default": "#7c3aed"
    }
  ],
