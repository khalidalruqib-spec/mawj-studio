{
  "language": "arabic",
  "animations": [
    "fadeIn",
    "pop",
    "slideUp",
    "zoomIn",
    "bounce"
  ],
  "transitions": [
    "cut",
    "wipe",
    "slide"
  ],
  "id": "capcut-news-alert",
  "name": "News Alert — CapCut",
  "category": "News Style",
  "aspectRatio": "9:16",
  "width": 1080,
  "height": 1920,
  "duration": 12,
  "description": "قالب أخبار عاجلة CapCut: شريط أحمر، BREAKING، عنوان، وتفاصيل — مثل قوالب TikTok الإخبارية.",
  "safeMargins": {
    "top": 160,
    "bottom": 260,
    "left": 70,
    "right": 70
  },
  "requiredInputs": [
    {
      "key": "headline",
      "label": "العنوان الرئيسي",
      "type": "textarea",
      "default": "عاجل: خبر مهم يهم الجميع",
      "required": true
    },
    {
      "key": "subhead",
      "label": "التفاصيل",
      "type": "textarea",
      "default": "التفاصيل الكاملة في الرابط بالبايو",
      "required": true
    },
    {
      "key": "source",
      "label": "المصدر",
      "type": "text",
      "default": "موج ستوديو",
      "required": true
    },
    {
      "key": "backgroundImage",
      "label": "صورة خلفية",
      "type": "image"
    },
    {
      "key": "brandColor",
      "label": "لون التنبيه",
      "type": "color",
      "default": "#dc2626"
    }
  ],
  "scenes": [
    {
      "id": "alert",
      "name": "Breaking Alert",
      "start": 0,
      "duration": 3,
      "background": {
        "type": "color",
        "value": "#0a0a0a"
      },
      "transition": {
        "type": "cut",
        "duration": 0.1
      },
      "layers": [
        {
          "id": "alert-red-top",
          "type": "shape",
          "shape": "rect",
          "x": 0,
          "y": 160,
          "width": 1080,
          "height": 120,
          "color": "{{brandColor}}",
          "opacity": 1,
          "borderRadius": 0
        },
        {
          "id": "alert-breaking",
          "type": "text",
          "content": "🔴 عاجل | BREAKING",
          "x": 0,
          "y": 185,
          "width": 1080,
          "height": 70,
          "fontSize": 44,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "direction": "ltr",
          "animationIn": {
            "type": "bounce",
            "duration": 0.4
          },
          "fontFamily": "var(--font-arabic), Cairo, \"IBM Plex Sans Arabic\", \"Noto Sans Arabic\", Tahoma, Arial, sans-serif",
          "lineHeight": 1.12,
          "letterSpacing": 0,
          "textStrokeColor": "rgba(0,0,0,0.76)",
          "textStrokeWidth": 7,
          "shadowColor": "rgba(0,0,0,0.38)",
          "shadowBlur": 14,
          "shadowOffsetX": 0,
          "shadowOffsetY": 7,
          "backgroundPadding": 0,
          "textTransform": "none"
        },
        {
          "id": "alert-ticker-bg",
          "type": "shape",
          "shape": "rect",
          "x": 0,
          "y": 280,
          "width": 1080,
          "height": 56,
          "color": "#111827",
          "opacity": 1,
          "borderRadius": 0
        },
        {
          "id": "alert-ticker",
          "type": "text",
          "content": "{{source}} • {{source}} • {{source}} •",
          "x": 0,
          "y": 292,
          "width": 1080,
          "height": 32,
          "fontSize": 24,
          "fontWeight": "bold",
          "color": "#fbbf24",
          "align": "center",
          "direction": "ltr",
          "animationIn": {
            "type": "slideLeft",
            "duration": 0.5
          },
          "fontFamily": "var(--font-arabic), Cairo, \"IBM Plex Sans Arabic\", \"Noto Sans Arabic\", Tahoma, Arial, sans-serif",
          "lineHeight": 1.12,
          "letterSpacing": 0,
          "textStrokeColor": "rgba(0,0,0,0.76)",
          "textStrokeWidth": 7,
          "shadowColor": "rgba(0,0,0,0.38)",
          "shadowBlur": 14,
          "shadowOffsetX": 0,
          "shadowOffsetY": 7,
          "backgroundPadding": 0,
          "textTransform": "none"
        },
        {
          "id": "alert-headline",
          "type": "text",
