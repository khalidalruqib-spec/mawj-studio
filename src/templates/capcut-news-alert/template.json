          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "direction": "rtl",
          "safeMargin": true,
          "editable": true,
          "animationIn": {
            "type": "slideUp",
            "duration": 0.4
          },
          "fontFamily": "var(--font-arabic), Cairo, \"IBM Plex Sans Arabic\", \"Noto Sans Arabic\", Tahoma, Arial, sans-serif",
          "lineHeight": 1.12,
          "letterSpacing": 0,
          "textStrokeColor": "rgba(0,0,0,0.76)",
          "textStrokeWidth": 7,
          "shadowColor": "rgba(0,0,0,0.38)",
          "shadowBlur": 14,
          "shadowOffsetX": 0,
          "shadowOffsetY": 7,
          "backgroundPadding": 0,
          "textTransform": "none"
