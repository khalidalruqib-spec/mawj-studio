        {
          "id": "detail-source-bg",
          "type": "shape",
          "shape": "rect",
          "x": 280,
          "y": 1320,
          "width": 520,
          "height": 64,
          "color": "{{brandColor}}",
          "opacity": 0.9,
          "borderRadius": 8,
          "safeMargin": true
