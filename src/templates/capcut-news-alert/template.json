      "start": 8,
      "duration": 4,
      "background": {
        "type": "gradient",
        "from": "{{brandColor}}",
        "to": "#7f1d1d"
      },
      "transition": {
        "type": "fade",
        "duration": 0.2
      },
      "layers": [
        {
          "id": "cta-headline",
          "type": "text",
          "content": "تابع للتحديثات",
          "x": 70,
          "y": 680,
          "width": 940,
          "height": 120,
          "fontSize": 64,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "direction": "rtl",
